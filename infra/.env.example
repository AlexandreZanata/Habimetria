# Rental Evidence Vault — local/dev defaults.
# Copy to `.env` next to docker-compose.yml:
#   cp infra/.env.example infra/.env
# Compose interpolates these via ${VAR:-default}; unset values fall back
# to the defaults below. Never commit real secrets.

# API
APP_ENV=development
PORT=8080
# Host-run default (outside compose). Inside compose the file uses
# postgres://vault:vault@postgres:5432/vault?sslmode=disable.
DATABASE_URL=postgres://vault:vault@localhost:5432/vault?sslmode=disable
VERIFY_BASE_URL=http://localhost:8080
# Optional same-origin web panel. For local use, set http://localhost:8080.
PANEL_ORIGIN=
# Private API defaults to owned resources even when the panel is disabled.
# Isolated local development only: unclaimed-development (never production).
LEGACY_API_MODE=owned

# Commercial providers and NEW sales are independently disabled by default.
# References are relative to COMMERCE_SECRETS_DIR: environment/store/filename.
# Never put service-account JSON, signing keys or real secrets in this file.
COMMERCE_ENV=
COMMERCE_NEW_PURCHASES_ENABLED=false
COMMERCE_SECRETS_DIR=/run/secrets/habimetria
# Host-only input for the optional read-only commerce Compose overlay.
COMMERCE_SECRETS_SOURCE_DIR=
GOOGLE_PLAY_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SECRET_REF=
APP_STORE_ENABLED=false
APP_STORE_BUNDLE_ID=
APP_STORE_APP_ID=
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_SECRET_REF=

# Storage (s3 = minio locally, local = filesystem via LOCAL_STORAGE_DIR)
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vault
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_PATH_STYLE=true
LOCAL_STORAGE_DIR=/tmp/vault-storage

# Trust: sign manifests with HMAC-SHA256. Generate a random 32+ byte key
# for any shared/beta environment, e.g. `openssl rand -hex 32`.
# The default below is dev-only and must never ship to production.
HMAC_KEY=dev-only-change-me

# For shared/beta/production: APP_ENV=production and a random 32+ byte HMAC_KEY.
# Per-seal payment/provider/price variables are retired. See docs/03-architecture/payments.md.

# Transactional account mail: disabled; referenced files only, no inline secrets.
ACCOUNT_MAIL_ENABLED=false
ACCOUNT_MAIL_ORIGIN=
ACCOUNT_MAIL_SMTP_ADDRESS=
ACCOUNT_MAIL_FROM=
ACCOUNT_MAIL_SMTP_MODE=starttls
ACCOUNT_MAIL_SMTP_USERNAME=
ACCOUNT_MAIL_SMTP_PASSWORD_FILE=
ACCOUNT_MAIL_PROOF_KEY_FILE=

# Optional account-mail worker overlay: explicit private host directory.
ACCOUNT_MAIL_SECRETS_SOURCE_DIR=
