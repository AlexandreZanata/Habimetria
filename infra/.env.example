# Rental Evidence Vault — local/dev defaults.
# Copy to `.env` next to docker-compose.yml:
#   cp infra/.env.example infra/.env
# Compose interpolates these via ${VAR:-default}; unset values fall back
# to the defaults below. Never commit real secrets.

# API
PORT=8080
# Host-run default (outside compose). Inside compose the file uses
# postgres://vault:vault@postgres:5432/vault?sslmode=disable.
DATABASE_URL=postgres://vault:vault@localhost:5432/vault?sslmode=disable
VERIFY_BASE_URL=http://localhost:8080

# Storage (s3 = minio locally, local = filesystem via LOCAL_STORAGE_DIR)
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vault
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_PATH_STYLE=true
LOCAL_STORAGE_DIR=/tmp/vault-storage

# Trust: sign manifests with HMAC-SHA256. Generate a random 32+ byte key
# for any shared/beta environment, e.g. `openssl rand -hex 32`.
# The default below is dev-only and must never ship to production.
HMAC_KEY=dev-only-change-me

# Paywall seam (MVP default off: photos + evidence + PDF stay frictionless)
PAYMENTS_MODE=off
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_API_BASE=https://api.stripe.com
ASAAS_API_KEY=
ASAAS_API_BASE=https://sandbox.asaas.com/api/v3
SEAL_PRICE_CENTS=2990
SEAL_CURRENCY=BRL
